---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Portafolio v4 | Diseñador & Desarrollador Full-Stack", 
  description = "Portafolio moderno y ecosistema de desarrollo creado con Astro, Tailwind CSS y Firebase. Listo para producción."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
      body {
        font-family: 'Inter', sans-serif;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Outfit', sans-serif;
      }
    </style>
  </head>
  <body class="bg-[#090d16] text-[#e2e8f0] min-h-screen relative overflow-x-hidden selection:bg-purple-500 selection:text-white">
    
    <!-- Glow Effects in Background -->
    <div class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-purple-900/10 blur-[120px] pointer-events-none -z-10"></div>
    <div class="absolute bottom-[20%] right-[-10%] w-[60vw] h-[60vw] rounded-full bg-indigo-900/10 blur-[150px] pointer-events-none -z-10"></div>
    <div class="absolute top-[40%] left-[30%] w-[40vw] h-[40vw] rounded-full bg-blue-900/5 blur-[100px] pointer-events-none -z-10"></div>

    <!-- Navigation Bar -->
    <header class="sticky top-0 z-50 w-full border-b border-white/5 bg-[#090d16]/75 backdrop-blur-md transition-all duration-300">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 md:px-8">
        <a href="#" id="nav-logo" class="flex items-center space-x-2 text-xl font-bold tracking-tight text-white hover:opacity-90 transition-opacity">
          <span class="bg-gradient-to-r from-purple-400 via-pink-400 to-indigo-400 bg-clip-text text-transparent">Portfolio v4</span>
        </a>
        <nav class="hidden md:flex space-x-8 text-sm font-medium text-slate-300">
          <a href="#hero" id="nav-link-inicio" class="hover:text-white transition-colors">Inicio</a>
          <a href="#proyectos" id="nav-link-proyectos" class="hover:text-white transition-colors">Proyectos</a>
          <a href="#ecosistema" id="nav-link-ecosistema" class="hover:text-white transition-colors">Ecosistema</a>
          <a href="#contacto" id="nav-link-contacto" class="hover:text-white transition-colors">Contacto</a>
        </nav>
        <div class="flex items-center space-x-4">
          <a href="#contacto" id="nav-btn-action" class="relative group overflow-hidden rounded-full p-px">
            <span class="absolute inset-0 bg-gradient-to-r from-purple-500 via-pink-500 to-indigo-500 rounded-full transition-all duration-300 group-hover:opacity-100"></span>
            <span class="relative block px-4 py-1.5 text-xs font-semibold text-white bg-slate-950 rounded-full group-hover:bg-slate-900 transition-colors">
              Hablemos
            </span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="relative">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/5 bg-slate-950/40 py-12">
      <div class="mx-auto max-w-7xl px-6 md:px-8 text-center md:text-left flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex flex-col items-center md:items-start space-y-2">
          <span class="text-lg font-bold bg-gradient-to-r from-purple-400 to-indigo-400 bg-clip-text text-transparent">Portfolio v4</span>
          <p class="text-xs text-slate-500">Diseñado y desarrollado en 2026. Todos los derechos reservados.</p>
        </div>
        <div class="flex flex-wrap justify-center gap-6 text-sm text-slate-400">
          <a href="#" class="hover:text-white transition-colors">Github</a>
          <a href="#" class="hover:text-white transition-colors">LinkedIn</a>
          <a href="#" class="hover:text-white transition-colors">Twitter</a>
        </div>
      </div>
    </footer>
  </body>
</html>
