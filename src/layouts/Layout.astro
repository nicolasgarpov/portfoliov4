---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Portafolio Legal & Político | Consultoría y Desarrollo Web", 
  description = "Desarrollo de sitios web institucionales, plataformas de eventos y campañas publicitarias digitales para abogados, firmas y el sector político."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet">
    
    <style>
      body, h1, h2, h3, h4, h5, h6 {
        font-family: 'Montserrat', sans-serif;
      }
    </style>
  </head>
  <body class="bg-brand-slate text-[#e2e8f0] min-h-screen relative overflow-x-hidden selection:bg-brand-gold selection:text-brand-slate">
    
    <!-- Professional Glow Effects in Background -->
    <div class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-brand-gold-glow blur-[140px] pointer-events-none -z-10"></div>
    <div class="absolute bottom-[20%] right-[-10%] w-[60vw] h-[60vw] rounded-full bg-brand-navy/15 blur-[160px] pointer-events-none -z-10"></div>
    <div class="absolute top-[45%] left-[25%] w-[45vw] h-[45vw] rounded-full bg-slate-900/40 blur-[120px] pointer-events-none -z-10"></div>

    <!-- Navigation Bar -->
    <header class="sticky top-0 z-50 w-full border-b border-white/5 bg-brand-slate/80 backdrop-blur-md transition-all duration-300">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 md:px-8">
        <a href="#" id="nav-logo" class="flex items-center space-x-2 text-xl font-bold tracking-tight text-white hover:opacity-90 transition-opacity">
          <span class="text-white">Portfolio</span>
          <span class="bg-gradient-to-r from-brand-gold via-[#e9c47a] to-brand-gold bg-clip-text text-transparent">Legal&Político</span>
        </a>
        <nav class="hidden md:flex space-x-8 text-sm font-medium text-slate-300">
          <a href="#inicio" id="nav-link-inicio" class="hover:text-brand-gold transition-colors">Inicio</a>
          <a href="#servicios" id="nav-link-servicios" class="hover:text-brand-gold transition-colors">Servicios</a>
          <a href="#proyectos" id="nav-link-proyectos" class="hover:text-brand-gold transition-colors">Proyectos</a>
          <a href="#registro" id="nav-link-registro" class="hover:text-brand-gold transition-colors">Contacto</a>
        </nav>
        <div class="flex items-center space-x-4">
          <a href="#registro" id="nav-btn-action" class="relative group overflow-hidden rounded-full p-px">
            <span class="absolute inset-0 bg-gradient-to-r from-brand-gold to-[#e9c47a] rounded-full transition-all duration-300"></span>
            <span class="relative block px-4 py-1.5 text-xs font-semibold text-white bg-slate-950 rounded-full group-hover:bg-slate-900 transition-colors">
              Iniciar Consulta
            </span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="relative">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/5 bg-slate-950/60 py-12">
      <div class="mx-auto max-w-7xl px-6 md:px-8 text-center md:text-left flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex flex-col items-center md:items-start space-y-2">
          <span class="text-lg font-bold text-white">Portfolio <span class="text-brand-gold">Legal&Político</span></span>
          <p class="text-xs text-slate-500">Diseñado y desarrollado para el sector corporativo, legal e institucional.</p>
        </div>
        <div class="flex flex-wrap justify-center gap-6 text-sm text-slate-400">
          <a href="https://github.com/nicolasgarpov" class="hover:text-brand-gold transition-colors">Github</a>
          <a href="#" class="hover:text-brand-gold transition-colors">LinkedIn</a>
          <a href="#" class="hover:text-brand-gold transition-colors">Portafolio Principal</a>
        </div>
      </div>
    </footer>
  </body>
</html>
