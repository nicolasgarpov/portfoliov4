---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portfolio v4 | Astro, Tailwind & Firebase">
  <!-- Hero Section -->
  <section id="hero" class="relative overflow-hidden pt-20 pb-24 md:pt-32 md:pb-36 flex flex-col items-center justify-center">
    <div class="mx-auto max-w-5xl px-6 md:px-8 text-center relative z-10">
      
      <!-- Premium Badge -->
      <div class="inline-flex items-center space-x-2 rounded-full border border-purple-500/20 bg-purple-500/5 px-3 py-1 text-xs text-purple-300 backdrop-blur-sm mb-6 animate-pulse">
        <span class="flex h-2 w-2 rounded-full bg-purple-400"></span>
        <span>Ecosistema de Desarrollo Activo v4.0</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl md:text-7xl font-extrabold tracking-tight text-white mb-6 leading-tight">
        Creando Experiencias Web
        <span class="block bg-gradient-to-r from-purple-400 via-pink-500 to-indigo-400 bg-clip-text text-transparent">
          Rápidas, Modernas y Escalables
        </span>
      </h1>

      <!-- Description -->
      <p class="mx-auto max-w-2xl text-base md:text-xl text-slate-400 mb-10 leading-relaxed">
        Bienvenido a tu nueva plantilla de desarrollo. Equipado con <strong class="text-slate-200">Astro</strong> para la velocidad, <strong class="text-slate-200">Tailwind CSS (v4)</strong> para un diseño fluido y <strong class="text-slate-200">Firebase</strong> listo para el backend.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#ecosistema" id="hero-btn-primary" class="w-full sm:w-auto px-8 py-3.5 rounded-full text-sm font-semibold text-white bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 shadow-lg shadow-purple-500/25 transition-all duration-300 hover:-translate-y-0.5 text-center">
          Explorar Ecosistema
        </a>
        <a href="#contacto" id="hero-btn-secondary" class="w-full sm:w-auto px-8 py-3.5 rounded-full text-sm font-semibold text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/15 hover:border-white/20 transition-all duration-300 hover:-translate-y-0.5 text-center">
          Probar Contacto
        </a>
      </div>
    </div>
  </section>

  <!-- Ecosistema / Tech Stack Section -->
  <section id="ecosistema" class="py-20 bg-slate-950/30 border-y border-white/5 relative">
    <div class="mx-auto max-w-7xl px-6 md:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-4">Ecosistema Integrado</h2>
        <p class="text-slate-400 text-sm md:text-base">Una suite tecnológica de alto nivel configurada de origen para iniciar cualquier proyecto.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Astro Card -->
        <div class="group relative rounded-3xl border border-white/5 bg-slate-900/40 p-8 hover:bg-slate-900/60 transition-all duration-300 hover:border-orange-500/20">
          <div class="absolute top-0 right-0 w-24 h-24 bg-orange-500/5 rounded-full blur-xl group-hover:bg-orange-500/10 transition-all duration-300"></div>
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-500/10 text-orange-400 group-hover:scale-110 transition-transform duration-300">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Astro</h3>
          <p class="text-slate-400 text-sm leading-relaxed mb-4">
            El framework ideal para sitios orientados a contenido. Con su arquitectura de islas, ofrece una velocidad de carga inigualable al no enviar JavaScript innecesario.
          </p>
          <ul class="text-xs text-slate-500 space-y-2">
            <li class="flex items-center gap-2"><span class="h-1 w-1 bg-orange-400 rounded-full"></span> Cero JavaScript por defecto</li>
            <li class="flex items-center gap-2"><span class="h-1 w-1 bg-orange-400 rounded-full"></span> Routing integrado</li>
            <li class="flex items-center gap-2"><span class="h-1 w-1 bg-orange-400 rounded-full"></span> Componentes flexibles</li>
          </ul>
        </div>

        <!-- Tailwind CSS Card -->
        <div class="group relative rounded-3xl border border-white/5 bg-slate-900/40 p-8 hover:bg-slate-900/60 transition-all duration-300 hover:border-cyan-500/20">
          <div class="absolute top-0 right-0 w-24 h-24 bg-cyan-500/5 rounded-full blur-xl group-hover:bg-cyan-500/10 transition-all duration-300"></div>
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-500/10 text-cyan-400 group-hover:scale-110 transition-transform duration-300">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Tailwind CSS v4</h3>
          <p class="text-slate-400 text-sm leading-relaxed mb-4">
            Motor de estilos de nueva generación integrado mediante Vite. Desarrollo ultra-rápido usando clases de utilidad modernas y una configuración simplificada en CSS.
          </p>
          <ul class="text-xs text-slate-500 space-y-2">
            <li class="flex items-center gap-2"><span class="h-1 w-1 bg-cyan-400 rounded-full"></span> Procesamiento nativo ultra veloz</li>
            <li class="flex items-center gap-2"><span class="h-1 w-1 bg-cyan-400 rounded-full"></span> Clases CSS dinámicas</li>
            <li class="flex items-center gap-2"><span class="h-1 w-1 bg-cyan-400 rounded-full"></span> Diseño responsivo intuitivo</li>
          </ul>
        </div>

        <!-- Firebase Card -->
        <div class="group relative rounded-3xl border border-white/5 bg-slate-900/40 p-8 hover:bg-slate-900/60 transition-all duration-300 hover:border-yellow-500/20">
          <div class="absolute top-0 right-0 w-24 h-24 bg-yellow-500/5 rounded-full blur-xl group-hover:bg-yellow-500/10 transition-all duration-300"></div>
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-yellow-500/10 text-yellow-400 group-hover:scale-110 transition-transform duration-300">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Firebase</h3>
          <p class="text-slate-400 text-sm leading-relaxed mb-4">
            Estructura base cliente configurada. Listo para conectar bases de datos Firestore, sistemas de autenticación y almacenamiento en la nube cuando lo requieras.
          </p>
          <ul class="text-xs text-slate-500 space-y-2">
            <li class="flex items-center gap-2"><span class="h-1 w-1 bg-yellow-400 rounded-full"></span> Inicializado en `src/lib/firebase.ts`</li>
            <li class="flex items-center gap-2"><span class="h-1 w-1 bg-yellow-400 rounded-full"></span> Configuración basada en variables `.env`</li>
            <li class="flex items-center gap-2"><span class="h-1 w-1 bg-yellow-400 rounded-full"></span> Listo para Auth y Firestore</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Proyectos Mock Section -->
  <section id="proyectos" class="py-20 relative">
    <div class="mx-auto max-w-7xl px-6 md:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-4">Proyectos Destacados</h2>
        <p class="text-slate-400 text-sm md:text-base">Ejemplo de diseño interactivo para tus proyectos futuros.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Project 1 -->
        <div class="group relative rounded-3xl border border-white/5 bg-slate-900/20 overflow-hidden hover:border-purple-500/20 transition-all duration-300">
          <div class="h-64 bg-gradient-to-br from-purple-900/40 via-slate-950 to-indigo-950 flex items-center justify-center p-8 border-b border-white/5 relative">
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-purple-500/10 via-transparent to-transparent opacity-60"></div>
            <div class="relative text-center">
              <span class="text-xs font-semibold tracking-widest text-purple-400 uppercase">Dashboard Admin</span>
              <p class="text-2xl font-bold text-white mt-2">Plataforma SaaS</p>
            </div>
          </div>
          <div class="p-8">
            <div class="flex gap-2 mb-4">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-800 text-slate-300">Astro</span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-800 text-slate-300">Tailwind</span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-800 text-slate-300">Firestore</span>
            </div>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              Un panel de control analítico integrado con bases de datos en tiempo real de Firebase para monitoreo de usuarios y transacciones de comercio electrónico.
            </p>
            <a href="#" class="inline-flex items-center text-sm font-semibold text-purple-400 group-hover:text-purple-300 transition-colors">
              Ver Proyecto 
              <svg class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="group relative rounded-3xl border border-white/5 bg-slate-900/20 overflow-hidden hover:border-indigo-500/20 transition-all duration-300">
          <div class="h-64 bg-gradient-to-br from-indigo-900/40 via-slate-950 to-pink-950 flex items-center justify-center p-8 border-b border-white/5 relative">
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-indigo-500/10 via-transparent to-transparent opacity-60"></div>
            <div class="relative text-center">
              <span class="text-xs font-semibold tracking-widest text-indigo-400 uppercase">E-Commerce</span>
              <p class="text-2xl font-bold text-white mt-2">Tienda de Diseño</p>
            </div>
          </div>
          <div class="p-8">
            <div class="flex gap-2 mb-4">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-800 text-slate-300">Astro</span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-800 text-slate-300">Tailwind</span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-800 text-slate-300">Firebase Auth</span>
            </div>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              Tienda en línea responsiva con carrito de compras reactivo, registro de clientes rápido vía Firebase Authentication y carga optimizada.
            </p>
            <a href="#" class="inline-flex items-center text-sm font-semibold text-indigo-400 group-hover:text-indigo-300 transition-colors">
              Ver Proyecto 
              <svg class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Contacto / Firebase Demo Section -->
  <section id="contacto" class="py-20 bg-slate-950/20 border-t border-white/5 relative">
    <div class="mx-auto max-w-4xl px-6 md:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-4">Formulario de Contacto</h2>
        <p class="text-slate-400 text-sm">
          Este formulario interactivo demuestra la integración lista del lado cliente. Envía un mensaje para probar las animaciones del estado de carga.
        </p>
      </div>

      <div class="relative rounded-3xl border border-white/10 bg-[#0c1220]/80 p-8 md:p-12 shadow-2xl backdrop-blur-xl max-w-2xl mx-auto">
        <form id="contact-form" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Nombre</label>
              <input type="text" id="name" required class="w-full bg-slate-950/60 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-600 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all text-sm" placeholder="Tu nombre" />
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Email</label>
              <input type="email" id="email" required class="w-full bg-slate-950/60 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-600 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all text-sm" placeholder="correo@ejemplo.com" />
            </div>
          </div>
          <div>
            <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Mensaje</label>
            <textarea id="message" rows="4" required class="w-full bg-slate-950/60 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-600 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all text-sm resize-none" placeholder="Escribe tu mensaje aquí..."></textarea>
          </div>

          <button type="submit" id="btn-submit" class="w-full relative group overflow-hidden rounded-xl p-px">
            <span class="absolute inset-0 bg-gradient-to-r from-purple-500 to-indigo-500 rounded-xl transition-all duration-300"></span>
            <span class="relative block w-full text-center py-3.5 text-sm font-semibold text-white bg-slate-950 rounded-xl group-hover:bg-slate-900/50 transition-all">
              <span id="btn-text">Enviar Mensaje</span>
              <span id="btn-loader" class="hidden">Procesando...</span>
            </span>
          </button>
        </form>

        <!-- Notification Banner -->
        <div id="form-toast" class="hidden mt-6 p-4 rounded-xl border border-emerald-500/20 bg-emerald-500/5 text-emerald-400 text-sm text-center">
          ¡Formulario enviado con éxito! (Modo Simulado. Conecta Firebase configurando tu archivo `.env`).
        </div>
      </div>

    </div>
  </section>

  <!-- Form Interactivity Script -->
  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text') as HTMLSpanElement | null;
    const btnLoader = document.getElementById('btn-loader') as HTMLSpanElement | null;
    const toast = document.getElementById('form-toast') as HTMLDivElement | null;

    if (form && btnSubmit && btnText && btnLoader && toast) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Disable button & show spinner
        btnSubmit.disabled = true;
        btnText.classList.add('hidden');
        btnLoader.classList.remove('hidden');

        // Simulate network request (e.g. sending to Firestore)
        await new Promise((resolve) => setTimeout(resolve, 1500));

        // Show Success toast
        toast.classList.remove('hidden');
        
        // Reset loader
        btnSubmit.disabled = false;
        btnText.classList.remove('hidden');
        btnLoader.classList.add('hidden');

        // Reset form
        form.reset();

        // Hide toast after 5 seconds
        setTimeout(() => {
          toast.classList.add('hidden');
        }, 5000);
      });
    }
  </script>
</Layout>
