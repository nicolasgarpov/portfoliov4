          formContainer.classList.remove("max-h-0", "opacity-0");
          formContainer.classList.add("max-h-[1000px]", "opacity-100");
          toggleFormBtn.classList.add("border-blue-500/50", "bg-blue-500/5");

          // Smooth scroll to the form
          setTimeout(() => {
            formContainer.scrollIntoView({
              behavior: "smooth",
              block: "nearest",
            });
          }, 150);
        } else {
          formContainer.classList.remove("max-h-[1000px]", "opacity-100");
          formContainer.classList.add("max-h-0", "opacity-0");
          toggleFormBtn.classList.remove("border-blue-500/50", "bg-blue-500/5");
