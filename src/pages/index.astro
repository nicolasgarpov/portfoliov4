---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Portfolio Legal & Político | Desarrollo Web Premium">
  <!-- Hero Section -->
  <section
    id="inicio"
    class="relative overflow-hidden pt-20 pb-24 md:pt-32 md:pb-36 flex flex-col items-center justify-center"
  >
    <div class="mx-auto max-w-5xl px-6 md:px-8 text-center relative z-10">
      <!-- Premium Badge -->
      <div
        class="inline-flex items-center space-x-2 rounded-full border border-brand-gold/30 bg-brand-gold/5 px-3 py-1 text-xs text-brand-gold backdrop-blur-sm mb-6"
      >
        <span class="flex h-2 w-2 rounded-full bg-brand-gold animate-pulse"
        ></span>
        <span>Desarrollo Web & Estrategia Digital Especializada</span>
      </div>

      <!-- Main Headline -->
      <h1
        class="text-4xl md:text-7xl font-extrabold tracking-tight text-white mb-6 leading-tight"
      >
        Presencia Digital de Alto Impacto para el
        <span
          class="block bg-gradient-to-r from-brand-gold via-[#e9c47a] to-brand-gold bg-clip-text text-transparent"
        >
          Sector Legal y Político
        </span>
      </h1>

      <!-- Description -->
      <p
        class="mx-auto max-w-2xl text-base md:text-xl text-slate-400 mb-10 leading-relaxed"
      >
        Desarrollo web premium y diseño gráfico de alta gama para el sector corporativo, legal y eventos internacionales. Especialista en identidades vectoriales impecables, formatos listos para imprenta a mediana escala y campañas de alto impacto en redes sociales.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#proyectos"
          id="hero-btn-primary"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full text-sm font-semibold text-brand-slate bg-gradient-to-r from-brand-gold to-[#e9c47a] hover:opacity-90 shadow-lg shadow-brand-gold/10 transition-all duration-300 hover:-translate-y-0.5 text-center"
        >
          Ver Casos de Éxito
        </a>
        <a
          href="#registro"
          id="hero-btn-secondary"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full text-sm font-semibold text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/15 hover:border-white/20 transition-all duration-300 hover:-translate-y-0.5 text-center"
        >
          Cotizar Proyecto
        </a>
      </div>
    </div>
  </section>

  <!-- Servicios Section -->
  <section
    id="servicios"
    class="py-20 bg-slate-950/40 border-y border-white/5 relative"
  >
    <div class="mx-auto max-w-7xl px-6 md:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2
          class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-4"
        >
          Servicios Especializados
        </h2>
        <p class="text-slate-400 text-sm md:text-base">
          Infraestructura y diseño orientados a cumplir las exigencias de
          formalidad, seguridad y conversión del sector.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Web & Platforms -->
        <div
          class="group relative rounded-3xl border border-white/5 bg-[#0d1322]/40 p-8 hover:bg-[#0d1322]/60 transition-all duration-300 hover:border-brand-gold/20"
        >
          <div
            class="absolute top-0 right-0 w-24 h-24 bg-brand-gold/5 rounded-full blur-xl group-hover:bg-brand-gold/10 transition-all duration-300"
          >
          </div>
          <div
            class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-gold/10 text-brand-gold group-hover:scale-110 transition-transform duration-300"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">
            Desarrollo Web & Landing Pages
          </h3>
          <p class="text-slate-400 text-sm leading-relaxed mb-4">
            Sitios web y plataformas institucionales ultra rápidos y responsivos. Diseñados a medida para congresos académicos, firmas de abogados y campañas, integrando registro de usuarios, agenda interactiva y SEO.
          </p>
          <ul class="text-xs text-slate-500 space-y-2">
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 bg-brand-gold rounded-full"></span> Registro de participantes y bases de datos
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 bg-brand-gold rounded-full"></span> Adaptación 100% responsiva y accesible
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 bg-brand-gold rounded-full"></span> SEO optimizado para visibilidad máxima
            </li>
          </ul>
        </div>

        <!-- Branding & Vector Design -->
        <div
          class="group relative rounded-3xl border border-white/5 bg-[#0d1322]/40 p-8 hover:bg-[#0d1322]/60 transition-all duration-300 hover:border-brand-gold/20"
        >
          <div
            class="absolute top-0 right-0 w-24 h-24 bg-brand-gold/5 rounded-full blur-xl group-hover:bg-brand-gold/10 transition-all duration-300"
          >
          </div>
          <div
            class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-gold/10 text-brand-gold group-hover:scale-110 transition-transform duration-300"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">
            Identidad Visual & Social Media
          </h3>
          <p class="text-slate-400 text-sm leading-relaxed mb-4">
            Branding de alto nivel con vectores perfectos que garantizan escalabilidad infinita. Planificación y diseño de plantillas e infografías para redes sociales (Instagram, Facebook) con las relaciones de aspecto exactas.
          </p>
          <ul class="text-xs text-slate-500 space-y-2">
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 bg-brand-gold rounded-full"></span> Diseños vectoriales nítidos y profesionales
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 bg-brand-gold rounded-full"></span> Formato de aspecto correcto para Instagram/redes
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 bg-brand-gold rounded-full"></span> Paletas corporativas sobrias y elegantes
            </li>
          </ul>
        </div>

        <!-- Print Media & Large Format -->
        <div
          class="group relative rounded-3xl border border-white/5 bg-[#0d1322]/40 p-8 hover:bg-[#0d1322]/60 transition-all duration-300 hover:border-brand-gold/20"
        >
          <div
            class="absolute top-0 right-0 w-24 h-24 bg-brand-gold/5 rounded-full blur-xl group-hover:bg-brand-gold/10 transition-all duration-300"
          >
          </div>
          <div
            class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-gold/10 text-brand-gold group-hover:scale-110 transition-transform duration-300"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">
            Imprenta Premium & Gran Formato
          </h3>
          <p class="text-slate-400 text-sm leading-relaxed mb-4">
            Especialista en imprenta de banners a mediana y gran escala (2000 mm a 2500 mm). Archivos listos para producción física bajo estándares técnicos rigurosos que garantizan nitidez extrema sin archivos extremadamente pesados.
          </p>
          <ul class="text-xs text-slate-500 space-y-2">
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 bg-brand-gold rounded-full"></span> Formato PDF/X-4 print-ready a 150 DPI
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 bg-brand-gold rounded-full"></span> Empaquetado completo (fuentes y vectores)
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 bg-brand-gold rounded-full"></span> Optimización de peso para imprenta rápida
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Proyectos Section -->
  <section id="proyectos" class="py-20 relative">
    <div class="mx-auto max-w-7xl px-6 md:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 flex flex-col items-center">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-4">Proyectos y Casos de Éxito</h2>
        <p class="text-slate-400 text-sm md:text-base max-w-2xl">
          Diseño visual, identidad corporativa y adaptaciones de alto nivel para el III Congreso Internacional de Litigación Oral.
        </p>
        
        <!-- Aviso de Volumen Realizado en tono azul elegante -->
        <div class="inline-flex items-center space-x-2.5 rounded-full border border-blue-500/20 bg-blue-950/40 px-4 py-2 text-[11px] md:text-xs text-blue-300 backdrop-blur-md mt-6 shadow-lg shadow-blue-950/20">
          <span class="flex h-2 w-2 rounded-full bg-blue-400 animate-pulse"></span>
          <span><strong>Proyecto de Gran Escala:</strong> Más de 30 piezas publicitarias y gráficas de alta gama realizadas para el evento final</span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Project 1: Promotion Flyers -->
        <div class="group relative rounded-3xl border border-white/5 bg-[#0c111e]/60 overflow-hidden hover:border-brand-gold/20 transition-all duration-300 flex flex-col justify-between cursor-pointer animate-fade-in" data-project="flyers">
          <div>
            <div class="h-56 overflow-hidden border-b border-white/5 relative">
              <img src="/images/flyer-4-junio.jpg" alt="Flyer Congreso Litigación Oral" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-slate-950/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                <span class="px-4 py-2 rounded-full bg-brand-gold text-brand-slate text-xs font-bold shadow-lg">Ver Detalles 🔍</span>
              </div>
            </div>
            <div class="p-6">
              <div class="flex gap-2 mb-4">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-800 text-slate-300">Social Media</span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-800 text-slate-300">Aspect Ratio 1:1</span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-brand-gold/10 text-brand-gold">Branding</span>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">Banners de Ponentes & Moderadores</h3>
              <p class="text-slate-400 text-xs leading-relaxed mb-4">
                Línea gráfica publicitaria unificada para expositores de múltiples países. Diseñados y planificados con el formato de relación de aspecto óptimo de Instagram/Facebook, facilitando legibilidad y una alta retención visual.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0">
            <button class="inline-flex items-center text-xs font-semibold text-brand-gold hover:text-brand-gold-hover transition-colors">
              Ver Detalles y Diseños (5)
              <svg class="ml-2 w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Project 2: Official Certificate -->
        <div class="group relative rounded-3xl border border-white/5 bg-[#0c111e]/60 overflow-hidden hover:border-brand-gold/20 transition-all duration-300 flex flex-col justify-between cursor-pointer animate-fade-in" data-project="certificado">
          <div>
            <div class="h-56 overflow-hidden border-b border-white/5 relative">
              <img src="/images/certificado-asistencia.jpg" alt="Certificado de Asistencia Oficial" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-slate-950/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                <span class="px-4 py-2 rounded-full bg-brand-gold text-brand-slate text-xs font-bold shadow-lg">Ver Detalles 🔍</span>
              </div>
            </div>
            <div class="p-6">
              <div class="flex gap-2 mb-4">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-800 text-slate-300">Diseño Editorial</span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-800 text-slate-300">Impresión Fiel</span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-brand-gold/10 text-brand-gold">Seguridad tipográfica</span>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">Certificado de Asistencia Oficial</h3>
              <p class="text-slate-400 text-xs leading-relaxed mb-4">
                Diseño sobrio emitido conjuntamente por UDLA, AEMAJ y CORJUSTICIA. Diseñado con estrictos parámetros editoriales, garantizando la legibilidad y adjuntando las fuentes tipográficas correctas para evitar errores en la imprenta.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0">
            <button class="inline-flex items-center text-xs font-semibold text-brand-gold hover:text-brand-gold-hover transition-colors">
              Ver Detalles y Certificado
              <svg class="ml-2 w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Project 3: Schedule Grid -->
        <div class="group relative rounded-3xl border border-white/5 bg-[#0c111e]/60 overflow-hidden hover:border-brand-gold/20 transition-all duration-300 flex flex-col justify-between cursor-pointer animate-fade-in" data-project="grilla">
          <div>
            <div class="h-56 overflow-hidden border-b border-white/5 relative">
              <img src="/images/grilla-expositores.jpg" alt="Grilla General del Congreso" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-slate-950/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                <span class="px-4 py-2 rounded-full bg-brand-gold text-brand-slate text-xs font-bold shadow-lg">Ver Detalles 🔍</span>
              </div>
            </div>
            <div class="p-6">
              <div class="flex gap-2 mb-4">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-800 text-slate-300">Mediana Escala</span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-800 text-slate-300">PDF/X-4 Ready</span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-brand-gold/10 text-brand-gold">150 DPI</span>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">Grilla General & Banner Imprenta</h3>
              <p class="text-slate-400 text-xs leading-relaxed mb-4">
                Estructuración visual y optimización técnica para banners de mediana escala (2000 mm a 2500 mm). Exportados en perfil PDF/X-4 print-ready a 150 DPI para asegurar máxima nitidez en impresión sin generar archivos gigantescos.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0">
            <button class="inline-flex items-center text-xs font-semibold text-brand-gold hover:text-brand-gold-hover transition-colors">
              Ver Detalles y Banner
              <svg class="ml-2 w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Premium Project Details Modal -->
  <div id="project-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 md:p-6 bg-slate-950/90 backdrop-blur-md hidden opacity-0 transition-all duration-300">
    <div class="relative w-full max-w-5xl bg-[#090f1d]/95 border border-white/10 rounded-3xl overflow-hidden shadow-2xl flex flex-col md:flex-row h-full max-h-[90vh] md:max-h-[80vh] transform scale-95 transition-all duration-300" id="project-modal-card">
      
      <!-- Close button -->
      <button id="btn-close-project-modal" class="absolute top-4 right-4 text-slate-400 hover:text-white transition-colors cursor-pointer p-2 rounded-xl bg-white/5 hover:bg-white/10 z-50">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Left Column: Visual Showcase (Image / Slider) -->
      <div class="relative w-full md:w-3/5 bg-slate-950 flex flex-col items-center justify-center p-6 border-b md:border-b-0 md:border-r border-white/5 group/viewer min-h-[40vh] md:min-h-0">
        <!-- Previous Arrow -->
        <button id="btn-prev-modal" class="absolute left-4 text-slate-300 hover:text-white transition-all hidden cursor-pointer p-2.5 rounded-full bg-slate-900/60 backdrop-blur-sm border border-white/10 hover:bg-slate-850 z-10">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <img id="modal-img" src="" alt="Vista del Proyecto" class="max-w-full max-h-[50vh] md:max-h-[60vh] rounded-xl object-contain shadow-2xl transition-all duration-300" />

        <!-- Next Arrow -->
        <button id="btn-next-modal" class="absolute right-4 text-slate-300 hover:text-white transition-all hidden cursor-pointer p-2.5 rounded-full bg-slate-900/60 backdrop-blur-sm border border-white/10 hover:bg-slate-850 z-10">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <!-- Slider indicator -->
        <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 px-3 py-1 rounded-full bg-slate-900/80 border border-white/10 text-[10px] font-bold text-slate-400" id="modal-slider-counter"></div>
      </div>

      <!-- Right Column: Rich Info Details Sidebar -->
      <div class="w-full md:w-2/5 p-6 md:p-8 flex flex-col justify-between overflow-y-auto max-h-[50vh] md:max-h-none">
        <div>
          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mb-4" id="modal-tags"></div>
          
          <!-- Title & Sub -->
          <h3 class="text-2xl font-bold text-white mb-1" id="modal-title"></h3>
          <p class="text-brand-gold text-xs font-semibold uppercase tracking-wider mb-4" id="modal-sub"></p>
          
          <!-- Divider -->
          <div class="h-px bg-white/5 my-4"></div>
          
          <!-- Description -->
          <div class="space-y-4 text-slate-300 text-sm leading-relaxed mb-6">
            <p id="modal-desc"></p>
          </div>

          <!-- Specs Table/Grid -->
          <div class="bg-white/5 rounded-2xl p-4 border border-white/5 space-y-3 mb-6">
            <h4 class="text-white text-xs font-bold uppercase tracking-wider mb-2">Especificaciones Técnicas</h4>
            <div class="grid grid-cols-2 gap-y-2.5 gap-x-4 text-xs">
              <div class="text-slate-500 font-medium">Cliente/Evento:</div>
              <div class="text-slate-300 text-right font-semibold" id="modal-spec-client"></div>
              
              <div class="text-slate-500 font-medium" id="modal-spec-label-1"></div>
              <div class="text-slate-300 text-right font-semibold" id="modal-spec-val-1"></div>
              
              <div class="text-slate-500 font-medium" id="modal-spec-label-2"></div>
              <div class="text-slate-300 text-right font-semibold" id="modal-spec-val-2"></div>
            </div>
          </div>
        </div>

        <!-- Call to Action inside Modal -->
        <div class="pt-4 border-t border-white/5 flex gap-3">
          <a href="#registro" id="modal-cta-btn" class="flex-1 text-center py-3 rounded-xl text-xs font-bold text-brand-slate bg-brand-gold hover:bg-brand-gold-hover transition-colors">
            Cotizar Diseño Similar
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Contacto / Event Registration -->
  <section
    id="registro"
    class="py-20 bg-slate-950/20 border-t border-white/5 relative"
  >
    <div class="mx-auto max-w-5xl px-6 md:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2
          class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-4"
        >
          Iniciar Consulta
        </h2>
        <p class="text-slate-400 text-sm">
          ¿Tienes una conferencia, campaña o evento próximamente? ¿O quieres
          potenciar tu marca y mejorar tu presencia en redes sociales? Elige el
          canal que te resulte más cómodo para comunicarte con nosotros.
        </p>
      </div>

      <!-- 3-Channel Grid Selector -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 max-w-4xl mx-auto">
        <!-- Option 1: WhatsApp -->
        <a
          href="https://wa.me/573024925974?text=Hola%20Nicol%C3%A1s%2C%20vi%20tu%20portafolio%20y%20me%20gustar%C3%ADa%20cotizar%20un%20proyecto."
          target="_blank"
          class="group relative rounded-3xl border border-white/5 bg-[#0d1322]/40 p-6 hover:bg-[#0d1322]/60 hover:border-emerald-500/30 hover:shadow-lg hover:shadow-emerald-500/5 transition-all duration-300 flex flex-col items-center text-center"
        >
          <div
