  <!-- Interactive JavaScript -->
  <script>
    import emailjs from '@emailjs/browser';

    const form = document.getElementById('event-form') as HTMLFormElement | null;
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text') as HTMLSpanElement | null;
    const btnLoader = document.getElementById('btn-loader') as HTMLSpanElement | null;
    const toast = document.getElementById('form-toast') as HTMLDivElement | null;

    // Toggle logic for collapsible form
    const toggleFormBtn = document.getElementById('btn-toggle-form');
    const formContainer = document.getElementById('quick-form-container');

    if (toggleFormBtn && formContainer) {
      toggleFormBtn.addEventListener('click', () => {
        if (formContainer.classList.contains('hidden')) {
          formContainer.classList.remove('hidden');
          // Force layout reflow
          formContainer.offsetHeight;
          formContainer.classList.remove('max-h-0', 'opacity-0');
          formContainer.classList.add('max-h-[1000px]', 'opacity-100');
          toggleFormBtn.classList.add('border-blue-500/50', 'bg-blue-500/5');
          
          // Smooth scroll to the form
          setTimeout(() => {
            formContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }, 150);
        } else {
          formContainer.classList.remove('max-h-[1000px]', 'opacity-100');
          formContainer.classList.add('max-h-0', 'opacity-0');
          toggleFormBtn.classList.remove('border-blue-500/50', 'bg-blue-500/5');
          setTimeout(() => {
            formContainer.classList.add('hidden');
          }, 500);
        }
      });
    }

    // Modal email options logic
    const emailOptionsBtn = document.getElementById('btn-email-options');
    const emailModal = document.getElementById('email-modal');
    const emailModalCard = document.getElementById('email-modal-card');
    const closeModalBtn = document.getElementById('btn-close-modal');
    const copyEmailBtn = document.getElementById('btn-copy-email');
    const copyText = document.getElementById('copy-text');
    const copySubtext = document.getElementById('copy-subtext');

    if (emailOptionsBtn && emailModal && emailModalCard && closeModalBtn) {
      const openModal = () => {
        emailModal.classList.remove('hidden');
        // Force reflow
        emailModal.offsetHeight;
        emailModal.classList.remove('opacity-0');
        emailModal.classList.add('opacity-100');
        emailModalCard.classList.remove('scale-95');
        emailModalCard.classList.add('scale-100');
      };

      const closeModal = () => {
        emailModal.classList.remove('opacity-100');
        emailModal.classList.add('opacity-0');
        emailModalCard.classList.remove('scale-100');
        emailModalCard.classList.add('scale-95');
        setTimeout(() => {
          emailModal.classList.add('hidden');
        }, 300);
      };

      emailOptionsBtn.addEventListener('click', openModal);
      closeModalBtn.addEventListener('click', closeModal);
      
      // Close modal on click outside card
      emailModal.addEventListener('click', (e) => {
        if (e.target === emailModal) {
          closeModal();
        }
      });

      // Escape key to close modal
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !emailModal.classList.contains('hidden')) {
          closeModal();
        }
      });
    }

    if (copyEmailBtn && copyText && copySubtext) {
      copyEmailBtn.addEventListener('click', () => {
        navigator.clipboard.writeText('nicolasgarpov64@gmail.com').then(() => {
          copyText.textContent = '¡Copiado!';
          copySubtext.textContent = 'Correo guardado en el portapapeles';
          
          setTimeout(() => {
            copyText.textContent = 'Copiar Correo';
            copySubtext.textContent = 'Copia nicolasgarpov64@gmail.com';
          }, 3000);
        }).catch(err => {
          console.error('No se pudo copiar el correo:', err);
        });
      });
    }

    // EmailJS keys from environment variables
    const SERVICE_ID = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID;
    const TEMPLATE_ID = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID;
    const PUBLIC_KEY = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY;

    if (form && btnSubmit && btnText && btnLoader && toast) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        btnSubmit.disabled = true;
        btnText.classList.add('hidden');
        btnLoader.classList.remove('hidden');

        const nameInput = document.getElementById('name') as HTMLInputElement | null;
        const emailInput = document.getElementById('email') as HTMLInputElement | null;
        const phoneInput = document.getElementById('phone') as HTMLInputElement | null;
        const typeSelect = document.getElementById('project-type') as HTMLSelectElement | null;
        const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;

        const templateParams = {
          from_name: nameInput?.value || '',
          reply_to: emailInput?.value || '',
          phone: phoneInput?.value || '',
          project_type: typeSelect?.options[typeSelect.selectedIndex]?.text || '',
          message: messageInput?.value || '',
          to_email: 'nicolasgarpov64@gmail.com'
        };

        // Check if EmailJS keys are populated
        const isEmailJSConfigured = SERVICE_ID && TEMPLATE_ID && PUBLIC_KEY;

        if (isEmailJSConfigured) {
          try {
            // Send real email
            await emailjs.send(SERVICE_ID, TEMPLATE_ID, templateParams, PUBLIC_KEY);

            // Show real success message
            toast.textContent = "¡Solicitud enviada con éxito! Te responderemos en la brevedad posible.";
            toast.className = "mt-6 p-4 rounded-xl border border-emerald-500/20 bg-emerald-500/5 text-emerald-400 text-sm text-center font-medium";
            toast.classList.remove('hidden');
            form.reset();
          } catch (error) {
            console.error("EmailJS Error:", error);
            // Show error message
            toast.textContent = "Hubo un error al enviar el correo. Por favor, reinténtalo más tarde.";
            toast.className = "mt-6 p-4 rounded-xl border border-red-500/20 bg-red-500/5 text-red-400 text-sm text-center font-medium";
            toast.classList.remove('hidden');
          }
        } else {
          // Fallback simulation mode
          await new Promise((resolve) => setTimeout(resolve, 1500));
          
          toast.textContent = "¡Formulario enviado con éxito (Modo Simulado)! Configura tus credenciales en el archivo .env.";
          toast.className = "mt-6 p-4 rounded-xl border border-brand-gold/30 bg-brand-gold/5 text-brand-gold text-sm text-center font-medium";
          toast.classList.remove('hidden');
          form.reset();
        }
        
        btnSubmit.disabled = false;
        btnText.classList.remove('hidden');
        btnLoader.classList.add('hidden');
        btnLoader.textContent = "Procesando..."; // Reset loader text

        setTimeout(() => {
          toast.classList.add('hidden');
        }, 7000);
      });
    }
  </script>
