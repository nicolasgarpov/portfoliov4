        sub: "Diseño Editorial y Seguridad Tipográfica",
        description: "Creación y diagramación del diploma oficial del congreso. Desarrollado bajo estrictas directrices de diseño institucional y académico. Para garantizar una impresión impecable y sin errores en talleres gráficos externos, empaquetamos y adjuntamos las fuentes tipográficas correctas correspondientes, previniendo alteraciones de espaciado o sustituciones erróneas.",
        client: "UDLA, AEMAJ & CORJUSTICIA",
        specLabel1: "Resolución Imprenta:",
        specVal1: "300 DPI (Alta Definición)",
        specLabel2: "Seguridad de Fuentes:",
        specVal2: "Tipografías adjuntadas",
        tags: ["Diseño Editorial", "Diplomas", "Impresión Premium", "Tipografía"],
        images: ["/images/certificado-asistencia.jpg"]
      },
      grilla: {
        title: "Grilla General & Banner Imprenta",
        sub: "Gran Formato y PDF/X-4 de Alto Rendimiento",
        description: "Planificación visual y diseño técnico de la grilla horaria del congreso e infografías generales para banners impresos de mediana escala (2000 mm a 2500 mm). Los archivos finales fueron estructurados y exportados con el perfil PDF/X-4 a 150 DPI, logrando nitidez extraordinaria y fidelidad cromática, manteniendo el peso del archivo sumamente optimizado y ligero para un procesamiento inmediato en imprenta.",
        client: "UDLA, AEMAJ & CORJUSTICIA",
        specLabel1: "Dimensiones Físicas:",
        specVal1: "2000 mm a 2500 mm",
        specLabel2: "Estándar de Salida:",
        specVal2: "PDF/X-4 (150 DPI Ready)",
        tags: ["Gran Formato", "Imprenta", "Optimización de Peso", "Infografía"],
        images: ["/images/grilla-expositores.jpg"]
      }
    };

    const projectModal = document.getElementById('project-modal');
    const projectModalCard = document.getElementById('project-modal-card');
    const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
    const modalTitle = document.getElementById('modal-title');
    const modalSub = document.getElementById('modal-sub');
    const modalDesc = document.getElementById('modal-desc');
    const modalTags = document.getElementById('modal-tags');
    const modalSpecClient = document.getElementById('modal-spec-client');
    const modalSpecLabel1 = document.getElementById('modal-spec-label-1');
    const modalSpecVal1 = document.getElementById('modal-spec-val-1');
    const modalSpecLabel2 = document.getElementById('modal-spec-label-2');
    const modalSpecVal2 = document.getElementById('modal-spec-val-2');

    const closeProjectModalBtn = document.getElementById('btn-close-project-modal');
    const prevModalBtn = document.getElementById('btn-prev-modal');
    const nextModalBtn = document.getElementById('btn-next-modal');
    const sliderCounter = document.getElementById('modal-slider-counter');

    console.log("Project Details Modal initialized in DOM. Elements:", {
      projectModal: !!projectModal,
      projectModalCard: !!projectModalCard,
      modalImg: !!modalImg,
      closeProjectModalBtn: !!closeProjectModalBtn
    });

    let currentImages: string[] = [];
    let currentImgIndex = 0;

    const openProjectModal = (projectId: string) => {
      console.log("openProjectModal called with ID:", projectId);
      const data = projectsData[projectId];
      if (!data) {
        console.error("Project data not found for ID:", projectId);
        return;
      }
      if (!projectModal || !projectModalCard || !modalImg) {
        console.error("Missing critical modal elements in openProjectModal!", {
          projectModal: !!projectModal,
          projectModalCard: !!projectModalCard,
          modalImg: !!modalImg
        });
        return;
      }

      // Populate Text & Info
      if (modalTitle) modalTitle.textContent = data.title;
      if (modalSub) modalSub.textContent = data.sub;
      if (modalDesc) modalDesc.textContent = data.description;
      if (modalSpecClient) modalSpecClient.textContent = data.client;
      if (modalSpecLabel1) modalSpecLabel1.textContent = data.specLabel1;
      if (modalSpecVal1) modalSpecVal1.textContent = data.specVal1;
      if (modalSpecLabel2) modalSpecLabel2.textContent = data.specLabel2;
      if (modalSpecVal2) modalSpecVal2.textContent = data.specVal2;

      // Render Tags
      if (modalTags) {
        modalTags.innerHTML = '';
        data.tags.forEach(tag => {
          const span = document.createElement('span');
          span.className = "px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-brand-navy/60 border border-brand-navy text-slate-300";
          span.textContent = tag;
          modalTags.appendChild(span);
        });
      }

      // Slider Setup
      currentImages = data.images;
      currentImgIndex = 0;
      updateModalSlider();

      // Show Modal with animation
      projectModal.classList.remove('hidden');
      projectModal.offsetHeight; // Force reflow
      projectModal.classList.remove('opacity-0');
      projectModal.classList.add('opacity-100');
      projectModalCard.classList.remove('scale-95');
      projectModalCard.classList.add('scale-100');
      console.log("Modal display styles updated successfully.");
    };

    const updateModalSlider = () => {
      if (!modalImg || !prevModalBtn || !nextModalBtn || !sliderCounter) return;

      modalImg.src = currentImages[currentImgIndex];

      if (currentImages.length > 1) {
        sliderCounter.textContent = `${currentImgIndex + 1} de ${currentImages.length}`;
        sliderCounter.classList.remove('hidden');
        prevModalBtn.classList.remove('hidden');
        nextModalBtn.classList.remove('hidden');
      } else {
        sliderCounter.classList.add('hidden');
        prevModalBtn.classList.add('hidden');
        nextModalBtn.classList.add('hidden');
      }
    };

    const closeProjectModal = () => {
      if (!projectModal || !projectModalCard) return;
      projectModal.classList.remove('opacity-100');
      projectModal.classList.add('opacity-0');
      projectModalCard.classList.remove('scale-100');
      projectModalCard.classList.add('scale-95');
      setTimeout(() => {
        projectModal.classList.add('hidden');
      }, 300);
    };

    const nextModalImage = () => {
      if (currentImages.length <= 1) return;
      currentImgIndex = (currentImgIndex + 1) % currentImages.length;
      updateModalSlider();
    };

    const prevModalImage = () => {
      if (currentImages.length <= 1) return;
      currentImgIndex = (currentImgIndex - 1 + currentImages.length) % currentImages.length;
      updateModalSlider();
    };

    // Attach click events
    document.querySelectorAll('[data-project]').forEach(el => {
      const id = el.getAttribute('data-project');
      console.log("Bound data-project element in DOM. Project ID:", id, "Element:", el);
      el.addEventListener('click', (e) => {
        console.log("Element clicked. Event target:", e.target, "Bound element ID:", id);
        e.preventDefault();
        e.stopPropagation();
        if (id) openProjectModal(id);
      });
    });

    if (closeProjectModalBtn) closeProjectModalBtn.addEventListener('click', closeProjectModal);
    if (nextModalBtn) nextModalBtn.addEventListener('click', nextModalImage);
    if (prevModalBtn) prevModalBtn.addEventListener('click', prevModalImage);

    // Keyboard controls
    document.addEventListener('keydown', (e) => {
      if (projectModal && !projectModal.classList.contains('hidden')) {
        if (e.key === 'Escape') closeProjectModal();
        if (e.key === 'ArrowRight') nextModalImage();
        if (e.key === 'ArrowLeft') prevModalImage();
      }
    });

    // Close on click outside card
    if (projectModal) {
      projectModal.addEventListener('click', (e) => {
        if (e.target === projectModal) {
          closeProjectModal();
        }
      });
    }

    // EmailJS keys from environment variables
    const SERVICE_ID = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID;
    const TEMPLATE_ID = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID;
    const PUBLIC_KEY = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY;

    if (form && btnSubmit && btnText && btnLoader && toast) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        btnSubmit.disabled = true;
        btnText.classList.add("hidden");
        btnLoader.classList.remove("hidden");

        const nameInput = document.getElementById(
          "name",
        ) as HTMLInputElement | null;
        const emailInput = document.getElementById(
          "email",
        ) as HTMLInputElement | null;
        const phoneInput = document.getElementById(
          "phone",
        ) as HTMLInputElement | null;
        const typeSelect = document.getElementById(
          "project-type",
        ) as HTMLSelectElement | null;
        const messageInput = document.getElementById(
          "message",
        ) as HTMLTextAreaElement | null;

        const templateParams = {
          from_name: nameInput?.value || "",
          reply_to: emailInput?.value || "",
          phone: phoneInput?.value || "",
          project_type:
            typeSelect?.options[typeSelect.selectedIndex]?.text || "",
          message: messageInput?.value || "",
          to_email: "nicolasgarpov64@gmail.com",
        };

        // Check if EmailJS keys are populated
        const isEmailJSConfigured = SERVICE_ID && TEMPLATE_ID && PUBLIC_KEY;

        if (isEmailJSConfigured) {
          try {
            // Send real email
            await emailjs.send(
              SERVICE_ID,
              TEMPLATE_ID,
              templateParams,
              PUBLIC_KEY,
            );

            // Show real success message
            toast.textContent =
              "¡Solicitud enviada con éxito! Te responderemos en la brevedad posible.";
            toast.className =
              "mt-6 p-4 rounded-xl border border-emerald-500/20 bg-emerald-500/5 text-emerald-400 text-sm text-center font-medium";
            toast.classList.remove("hidden");
            form.reset();
          } catch (error) {
            console.error("EmailJS Error:", error);
            // Show error message
            toast.textContent =
              "Hubo un error al enviar el correo. Por favor, reinténtalo más tarde.";
            toast.className =
              "mt-6 p-4 rounded-xl border border-red-500/20 bg-red-500/5 text-red-400 text-sm text-center font-medium";
            toast.classList.remove("hidden");
          }
        } else {
          // Fallback simulation mode
          await new Promise((resolve) => setTimeout(resolve, 1500));

          toast.textContent =
            "¡Formulario enviado con éxito (Modo Simulado)! Configura tus credenciales en el archivo .env.";
          toast.className =
            "mt-6 p-4 rounded-xl border border-brand-gold/30 bg-brand-gold/5 text-brand-gold text-sm text-center font-medium";
          toast.classList.remove("hidden");
          form.reset();
        }

        btnSubmit.disabled = false;
        btnText.classList.remove("hidden");
        btnLoader.classList.add("hidden");
        btnLoader.textContent = "Procesando..."; // Reset loader text

        setTimeout(() => {
          toast.classList.add("hidden");
        }, 7000);
      });
    }
  </script>
</Layout>
